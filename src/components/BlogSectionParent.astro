---
import BlogSection from "../components/BlogSection.astro";

const allPosts = await Astro.glob("../content/posts/*.mdx");
const {
	posts = allPosts,
	currentPage,
	totalPages,
	basePath = "/blog",
	showMore = false,
} = Astro.props;

const hasPagination = currentPage && totalPages && totalPages > 1;

function pageHref(page) {
	return page === 1 ? basePath : `${basePath}/${page}`;
}

---
<div class="max-w-2xl mx-auto text-center mb-10">
    <a href="/blog" class="hover:text-gray-800"><h1 class="text-2xl font-bold md:text-4xl md:leading-tight dark:text-white">Insights</h1></a>
    <p class="mt-1 text-gray-600 dark:text-gray-400">Stay in the know with insights from industry experts.</p>
</div>
<!-- End Title -->

<!-- Grid -->
<div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-10 lg:max-w-[90%] mx-auto">
    {
        posts.map((post) => (
            <BlogSection imagePath={post.frontmatter.imagePath} title={post.frontmatter.title} intro={post.frontmatter.intro} />
        ))
    }
</div>

{
    showMore ? (
        <div class="mt-10 flex justify-center">
            <a class="py-3 px-4 inline-flex items-center gap-x-2 text-sm font-medium rounded-lg border border-transparent bg-blue-600 text-white hover:bg-blue-700 focus:outline-hidden focus:bg-blue-700 disabled:opacity-50 disabled:pointer-events-none dark:focus:ring-1 dark:focus:ring-gray-600" href="/blog/">
                Show more
                <svg class="shrink-0 size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m9 18 6-6-6-6" />
                </svg>
            </a>
        </div>
    ) : null
}

{
    hasPagination ? (
        <nav class="mt-12 flex items-center justify-center gap-x-1" aria-label="Blog pagination">
            {
                currentPage > 1 ? (
                    <a class="min-h-9.5 min-w-9.5 py-2 px-2.5 inline-flex justify-center items-center gap-x-2 text-sm rounded-lg text-gray-800 hover:bg-gray-100 focus:outline-hidden focus:bg-gray-100 disabled:opacity-50 disabled:pointer-events-none dark:text-white dark:hover:bg-white/10 dark:focus:bg-white/10" href={pageHref(currentPage - 1)} aria-label="Previous page">
                        <svg class="shrink-0 size-3.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m15 18-6-6 6-6" />
                        </svg>
                        <span>Previous</span>
                    </a>
                ) : (
                    <span class="min-h-9.5 min-w-9.5 py-2 px-2.5 inline-flex justify-center items-center gap-x-2 text-sm rounded-lg text-gray-400 opacity-50 pointer-events-none dark:text-neutral-500" aria-disabled="true">
                        <svg class="shrink-0 size-3.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m15 18-6-6 6-6" />
                        </svg>
                        <span>Previous</span>
                    </span>
                )
            }
            {
                Array.from({ length: totalPages }, (_, index) => index + 1).map((page) => (
                    <a
                        class={page === currentPage ? "min-h-9.5 min-w-9.5 flex justify-center items-center bg-gray-200 text-gray-800 py-2 px-3 text-sm rounded-lg focus:outline-hidden focus:bg-gray-300 disabled:opacity-50 disabled:pointer-events-none dark:bg-neutral-600 dark:text-white dark:focus:bg-neutral-500" : "min-h-9.5 min-w-9.5 flex justify-center items-center text-gray-800 hover:bg-gray-100 py-2 px-3 text-sm rounded-lg focus:outline-hidden focus:bg-gray-100 disabled:opacity-50 disabled:pointer-events-none dark:text-white dark:hover:bg-white/10 dark:focus:bg-white/10"}
                        href={pageHref(page)}
                        aria-current={page === currentPage ? "page" : undefined}
                    >
                        {page}
                    </a>
                ))
            }
            {
                currentPage < totalPages ? (
                    <a class="min-h-9.5 min-w-9.5 py-2 px-2.5 inline-flex justify-center items-center gap-x-2 text-sm rounded-lg text-gray-800 hover:bg-gray-100 focus:outline-hidden focus:bg-gray-100 disabled:opacity-50 disabled:pointer-events-none dark:text-white dark:hover:bg-white/10 dark:focus:bg-white/10" href={pageHref(currentPage + 1)} aria-label="Next page">
                        <span>Next</span>
                        <svg class="shrink-0 size-3.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m9 18 6-6-6-6" />
                        </svg>
                    </a>
                ) : (
                    <span class="min-h-9.5 min-w-9.5 py-2 px-2.5 inline-flex justify-center items-center gap-x-2 text-sm rounded-lg text-gray-400 opacity-50 pointer-events-none dark:text-neutral-500" aria-disabled="true">
                        <span>Next</span>
                        <svg class="shrink-0 size-3.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m9 18 6-6-6-6" />
                        </svg>
                    </span>
                )
            }
        </nav>
    ) : null
}
    
