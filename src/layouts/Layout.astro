---
import productData from "../products.json";
import { toAbsoluteUrl } from "../utils/seo";

interface Props {
	title: string;
	description: string;
	canonical?: string | URL;
	ogImage?: string | URL;
	ogType?: string;
	noindex?: boolean;
	structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
	title,
	description,
	canonical,
	ogImage = "/android-chrome-512x512.png",
	ogType = "website",
	noindex = false,
	structuredData = [],
} = Astro.props as Props;

import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

//TailwindCSS
import "../base.css";

const siteUrl = Astro.site ?? new URL("https://www.jainhydraulics.com");
const canonicalUrl = toAbsoluteUrl(canonical ?? Astro.url, siteUrl);
const ogImageUrl = toAbsoluteUrl(ogImage, siteUrl);
const socialLinks = Object.values(productData.socials).filter(
	(value) =>
		value.startsWith("http") &&
		!value.includes("your_username") &&
		!value.includes("your_page"),
);
const organizationSchema = {
	"@context": "https://schema.org",
	"@type": "Organization",
	name: "Jain Hydraulics Recycling",
	url: siteUrl.toString(),
	logo: toAbsoluteUrl("/android-chrome-512x512.png", siteUrl),
	sameAs: socialLinks,
	contactPoint: [
		{
			"@type": "ContactPoint",
			contactType: "sales",
			telephone: productData.contact.phoneSales[0].trim(),
			areaServed: "IN",
			availableLanguage: ["en", "hi"],
		},
		{
			"@type": "ContactPoint",
			contactType: "customer support",
			telephone: productData.contact.phoneSupport[0].trim(),
			areaServed: "IN",
			availableLanguage: ["en", "hi"],
		},
	],
	address: {
		"@type": "PostalAddress",
		streetAddress: productData.contact.address[0],
		addressLocality: "Delhi",
		postalCode: "110041",
		addressCountry: "IN",
	},
};
const websiteSchema = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	name: "Jain Hydraulics Recycling",
	url: siteUrl.toString(),
};
const schemaNodes = [
	organizationSchema,
	websiteSchema,
	...(Array.isArray(structuredData) ? structuredData : [structuredData]),
].filter(Boolean);
---

<!doctype html>
<html class="scroll-smooth" lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		{noindex ? <meta name="robots" content="noindex, nofollow" /> : null}
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<link rel="canonical" href={canonicalUrl} />
		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content="Jain Hydraulics Recycling" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogImageUrl} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />
		<meta
			name="google-site-verification"
			content="q7UjDQnu0ekOY01LyiXchlAgf7L-mbbsWJLZqLHCFVc"
		/>
		<title>{title}</title>
		<link rel="sitemap" href="/sitemap-index.xml" />
		<script type="application/ld+json" set:html={JSON.stringify(schemaNodes)} />
	</head>
	<body>
		<Navbar />
		<slot />
		<Footer />
		<script>
			import "preline/dist/preline.js";
		</script>

		<script async src="https://www.googletagmanager.com/gtag/js?id=G-YFDZ2P3BKB"></script>
		<script>
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				dataLayer.push(arguments);
			}
			gtag("js", new Date());

			gtag("config", "G-YFDZ2P3BKB");
		</script>
	</body>
</html>
