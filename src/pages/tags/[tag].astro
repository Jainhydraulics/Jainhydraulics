---
import Layout from "../../layouts/Layout.astro";
import BlogSection from "../../components/BlogSection.astro";
import { humanizeSlug } from "../../utils/seo";

export async function getStaticPaths() {
	const allPosts = await Astro.glob("../../content/posts/*.mdx");
	const tagMap = new Map();

	for (const post of allPosts) {
		for (const rawTag of post.frontmatter.tags ?? []) {
			const slug = rawTag
				.normalize("NFKD")
				.replace(/[\u0300-\u036f]/g, "")
				.toLowerCase()
				.replace(/[^a-z0-9]+/g, "-")
				.replace(/^-+|-+$/g, "")
				.replace(/-{2,}/g, "-");
			const entry = tagMap.get(slug) ?? {
				label: humanizeSlug(slug),
				posts: [],
			};

			entry.posts.push(post);
			tagMap.set(slug, entry);
		}
	}

	return [...tagMap.entries()].map(([tag, value]) => ({
		params: { tag },
		props: value,
	}));
}

const { tag } = Astro.params;
const { posts, label } = Astro.props;
const pageTitle = `${label} Insights | Jain Hydraulics Recycling`;
const pageDescription = `Read Jain Hydraulics Recycling insights about ${label.toLowerCase()}, including industry trends, recycling guidance, and machine applications.`;

---

<Layout title={pageTitle} description={pageDescription} canonical={new URL(Astro.url.pathname, Astro.site)}>
    
    <div class="max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 mx-auto">
        <div class="max-w-2xl mx-auto text-center mb-10 lg:mb-14">
            <h1 class="text-2xl font-bold md:text-4xl md:leading-tight dark:text-white">Insights on {label}</h1>
            <p class="mt-1 text-gray-600 dark:text-gray-400">Browse articles from Jain Hydraulics Recycling focused on {label.toLowerCase()}.</p>
        </div>
        <!-- End Title -->
        
        <!-- Grid -->
        <div class="grid md:grid-cols-2 gap-10 md:max-w-[60%] mx-auto">
            {
                posts.map((post) => (
                    <BlogSection imagePath={post.frontmatter.imagePath} title={post.frontmatter.title} intro={post.frontmatter.intro} />
                ))
            }
            
        </div>
        
    </div>
    
</Layout>
