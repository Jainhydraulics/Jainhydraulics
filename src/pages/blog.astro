---
import BlogSectionParent from "../components/BlogSectionParent.astro";
import Layout from "../layouts/Layout.astro";
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const pageSize = 4;
const allPosts = (await Astro.glob("../content/posts/*.mdx")).sort(
    (a, b) =>
        new Date(b.frontmatter.pubDate ?? 0).getTime() -
        new Date(a.frontmatter.pubDate ?? 0).getTime()
);
const pagePosts = allPosts.slice(0, pageSize);
const totalPages = Math.ceil(allPosts.length / pageSize);
---

<Layout canonical={canonicalURL}  title="Insights from Jain Hydraulics Recycling: Manufacturers of Hydraulic Scrap Press/Baler Machine, Shears/Cutting Machines, and Shredders Machine" description="Dive into the dynamic world of metal, metal scrap and waste recycling processing with 'Insights'—Jain Hydraulics Recycling's blog hub. Stay updated on the latest news, trends, and innovations, as we share valuable insights that shape the sustainable future of recycling. Explore our blog for a deeper understanding of the ever-evolving landscape in metal and waste recycling.">
    <div class="max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 mx-auto">
        <BlogSectionParent posts={pagePosts} currentPage={1} totalPages={totalPages} />
    </div>
    
</Layout>
