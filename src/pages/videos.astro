---
import Layout from "../layouts/Layout.astro";
import { getVideos } from "../utils/videos";

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const videos = getVideos();
---

<Layout
	canonical={canonicalURL}
	title="Machine Videos | Jain Hydraulics Recycling"
	description="Watch Jain Hydraulics Recycling machine videos for hydraulic balers, scrap shears, shredders, and recycling equipment demos."
>
	<main class="max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 mx-auto">
		<div class="max-w-2xl mx-auto text-center mb-10">
			<h1 class="text-3xl font-bold tracking-tighter text-gray-900 md:text-5xl">Machine Videos</h1>
			<p class="mt-3 text-lg leading-relaxed text-gray-600">
				Watch Jain Hydraulics Recycling equipment in action, from hydraulic balers to scrap shears and shredders.
			</p>
		</div>

		<div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
			{
				videos.map((video) => (
					<a class="group rounded-xl border border-gray-200 bg-white shadow-sm transition hover:shadow-md dark:border-gray-700 dark:bg-slate-900" href={video.url}>
						<div class="relative overflow-hidden rounded-t-xl bg-gray-900">
							<img class="aspect-video w-full object-cover transition duration-500 group-hover:scale-105" src={video.thumbnailUrl} alt={`${video.title} thumbnail`} loading="lazy" />
							<span class="absolute inset-0 flex items-center justify-center">
								<span class="inline-flex h-14 w-14 items-center justify-center rounded-full bg-white/90 text-blue-600 shadow">
									<svg class="h-6 w-6 translate-x-0.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
										<path d="M8 5v14l11-7z" />
									</svg>
								</span>
							</span>
						</div>
						<div class="p-5">
							<p class="text-xs font-semibold uppercase tracking-wide text-blue-600">{video.productType}</p>
							<h2 class="mt-2 text-xl font-bold tracking-tighter text-gray-800 group-hover:text-gray-600 dark:text-gray-200">
								{video.title}
							</h2>
							<p class="mt-2 line-clamp-3 text-sm text-gray-600 dark:text-gray-400">{video.description}</p>
						</div>
					</a>
				))
			}
		</div>
	</main>
</Layout>
